{
  "name": "archeion",
  "version": "0.0.1",
  "description": "Astro Starlight で作る Wiki 風の静的サイト",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint-staged": "lint-staged",
    "knip": "knip",
    "verify:citations": "node scripts/verify-citations.ts",
    "link:names": "node scripts/link-names.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,jsonc,astro,css,yaml,yml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "author": "pithos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithos-day/Archeion.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.3.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@types/hast": "3.0.5",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3"
  }
}
