---
import type { Article } from '../lib/articles';

interface Props {
  title: string;
  infobox: NonNullable<Article['data']['infobox']>;
}

const { title, infobox } = Astro.props;
---

<table class="infobox not-content">
  <tr>
    <th colspan="2" class="title">{infobox.title ?? title}</th>
  </tr>
  {
    infobox.image && (
      <tr>
        <td colspan="2" class="image">
          <img src={infobox.image} alt={infobox.caption ?? ''} />
          {infobox.caption && <div class="caption">{infobox.caption}</div>}
        </td>
      </tr>
    )
  }
  {
    infobox.rows.map((row) => (
      <tr>
        <th scope="row">{row.label}</th>
        <td>{row.value}</td>
      </tr>
    ))
  }
</table>

<style>
  .infobox {
    display: table;
    float: right;
    clear: right;
    width: 22em;
    margin: 0 0 1rem 1.25rem;
    border: 1px solid var(--wiki-border);
    border-spacing: 0.2em;
    background: var(--wiki-box-bg);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .title {
    padding: 0.3em;
    text-align: center;
    font-family: var(--wiki-font-serif);
    font-size: 1.25em;
    font-weight: 700;
  }
  th,
  td {
    padding: 0.2em 0.4em;
    border: none;
    vertical-align: top;
    text-align: start;
  }
  th:not(.title) {
    width: 35%;
    font-weight: 700;
  }
  .image {
    text-align: center;
  }
  img {
    max-width: 100%;
    max-height: 16rem;
    margin-inline: auto;
  }
  .caption {
    font-size: var(--sl-text-xs);
  }
  @media (max-width: 50rem) {
    .infobox {
      float: none;
      width: 100%;
      margin: 0 0 1rem;
    }
  }
</style>
