---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import Infobox from '../Infobox.astro';
import TocBox from '../TocBox.astro';

const { entry, headings } = Astro.locals.starlightRoute;
const { title, infobox, template, tableOfContents } = entry.data;
const showToc = template !== 'splash' && tableOfContents !== false;
// 脚注の一覧に自動で付く見出しは、本文の「## 脚注」と重なるので目次に出さない
const tocHeadings = headings.filter((heading) => heading.slug !== 'footnote-label');

/**
 * Wikipedia と同じく、目次はリード文の後 (最初の h2 の直前) に置く。
 * そのため本文を HTML として受け取り、最初の h2 の位置で分割する。
 */
const html = showToc ? await Astro.slots.render('default') : '';
const firstH2 = html.search(/<div class="sl-heading-wrapper level-h2|<h2[\s>]/);
const [beforeH2, rest] =
  firstH2 === -1 ? [html, ''] : [html.slice(0, firstH2), html.slice(firstH2)];

/** 記事冒頭の ambox は、Wikipedia と同じく情報ボックスより上に全幅で置く。 */
const amboxEnds = [...beforeH2.matchAll(/<i data-ambox-end[^>]*><\/i>/g)];
const lastAmboxEnd = amboxEnds.at(-1);
const bannerEnd = lastAmboxEnd ? (lastAmboxEnd.index ?? 0) + lastAmboxEnd[0].length : 0;
const [banners, lead] = [beforeH2.slice(0, bannerEnd), beforeH2.slice(bannerEnd)];
---

<Default>
  {showToc && <Fragment set:html={banners} />}
  {infobox && <Infobox title={title} infobox={infobox} />}
  {
    showToc ? (
      <>
        <Fragment set:html={lead} />
        <TocBox headings={tocHeadings} />
        <Fragment set:html={rest} />
      </>
    ) : (
      <slot />
    )
  }
</Default>
