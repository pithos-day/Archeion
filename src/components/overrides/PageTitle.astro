---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry, siteTitle } = Astro.locals.starlightRoute;
// 「出典」は記事ページだけに出す。メインページと、本文 (body) を持たない
// src/pages の特別ページ (StarlightPage で作る仮想エントリー) には出さない。
const isArticle = Astro.url.pathname !== '/' && Boolean(entry.body);
---

<Default />
{isArticle && <p class="tagline">出典: {siteTitle}</p>}

<style>
  .tagline {
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
